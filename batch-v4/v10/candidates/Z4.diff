+import assert from "node:assert/strict";
+import test from "node:test";
+import { errorClass } from "./oct2024-tenmin-oneoff";
+
+test("error classes", () => {
+  assert.equal(errorClass("TIMEOUT after 30s"), "TIMEOUT");
+  assert.equal(errorClass({ message: "MASSIVE_HTTP_429:retry" }), "MASSIVE_HTTP_429");
+  assert.equal(errorClass(":leading colon"), "ERROR");
+  assert.equal(errorClass(""), "ERROR");
+  assert.equal(errorClass(null), "null");
+  assert.equal(errorClass("ABCDEFGHIJABCDEFGHIJABCDEFGHIJABCDEFGHIJABCDEFGHIJABCDEFGHIJABCDEFGHIJ tail"), "ABCDEFGHIJABCDEFGHIJABCDEFGHIJABCDEFGHIJABCDEFGHIJABCDEFGHIJ");
+});
