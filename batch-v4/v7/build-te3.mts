import { execFileSync } from "node:child_process";
import { createHash } from "node:crypto";
import { mkdirSync, readFileSync, writeFileSync } from "node:fs";
import ts from "/workspace/v4-ws/node_modules/typescript/lib/typescript.js";
import { existingTargetRefusal } from "/workspace/v4-ws/peaceai/lib/learned-test-existing.ts";
import { classifyLicense } from "/workspace/v4-ws/peaceai/lib/lmcorpus.ts";
const WS = "/workspace/v4-ws";
mkdirSync(`${WS}/peaceai/test/fixtures/m88-te3`, { recursive: true });
const corpus = JSON.parse(readFileSync("corpus.json", "utf8")) as { repos: (string | { name: string })[]; shas: string[] };
const cshas = new Set(corpus.shas);
const pick = JSON.parse(readFileSync("te3-pick.json", "utf8")) as { repo: string; commit: string; test: string; module: string; fn: string; v1: string; v2: string; framework: string; src: string }[];
const git = (d: string, ...a: string[]) => execFileSync("git", ["-C", d, ...a], { maxBuffer: 1 << 28 });
const sha256 = (b: Buffer | string) => createHash("sha256").update(b).digest("hex");
const out: unknown[] = []; const pins: unknown[] = []; const notices: { repo: string; commit: string; licFile: string; licText: string; spdx: string; fixtures: string[] }[] = [];
const perRepo = new Map<string, number>();
for (const x of pick) { try {
  if ((perRepo.get(x.repo) ?? 0) >= 3) throw new Error("cap 3 per repo");
  const d = `${x.src}/${x.repo.replace("/", "__")}`;
  const files = new Set(git(d, "ls-tree", "-r", "--name-only", x.commit).toString().split("\n"));
  const reads = new Set<string>();
  const read = (rel: string): string | null => { if (!files.has(rel)) return null; reads.add(rel); try { return git(d, "show", `${x.commit}:${rel}`).toString("utf8"); } catch { return null; } };
  const content = git(d, "show", `${x.commit}:${x.module}`).toString("utf8");
  const r1 = existingTargetRefusal(x.module, content, x.fn);
  const r2 = existingTargetRefusal(x.module, content, x.fn, { v2: { read } });
  const r3 = existingTargetRefusal(x.module, content, x.fn, { v2: { read }, dates: true });
  if (r1 === null || r2 === null || r3 !== null) throw new Error(`replay ${r1} ${r2} ${r3}`);
  const all = [...reads].filter((p) => p !== x.module).sort();
  const need = all.filter((p) => existingTargetRefusal(x.module, content, x.fn, { v2: { read: (rel) => (rel === p ? null : all.includes(rel) ? read(rel) : null) }, dates: true }) !== null);
  const sibRead = (rel: string) => (need.includes(rel) ? read(rel) : null);
  if (existingTargetRefusal(x.module, content, x.fn, { v2: { read: sibRead }, dates: true }) !== null) throw new Error("minimal set does not replay");
  if (existingTargetRefusal(x.module, content, x.fn, { v2: { read: sibRead } }) === null) throw new Error("v2 accepts with the minimal set");
  const names = git(d, "ls-tree", "--name-only", x.commit).toString().split("\n").filter((n) => /^(?:LICEN[CS]E|COPYING)(?:\.\w+)?$/i.test(n));
  if (names.length < 1) throw new Error("no license");
  const licText = git(d, "show", `${x.commit}:${names[0]}`).toString("utf8");
  const classified = classifyLicense(licText);
  if (!classified) throw new Error("license unclassified");
  const pinFile = (path: string) => {
    const blob = git(d, "rev-parse", `${x.commit}:${path}`).toString().trim();
    const b = git(d, "cat-file", "blob", blob);
    if (b.length > 65536) throw new Error(`size ${path}`);
    if (/[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}/.test(b.toString("utf8"))) throw new Error(`email in ${path}`);
    if (cshas.has(sha256(b))) throw new Error(`corpus sha ${path}`);
    const fixture = `peaceai/test/fixtures/m88-te3/${x.repo.replace("/", "__")}-${blob.slice(0, 12)}.txt`;
    writeFileSync(`${WS}/${fixture}`, b);
    return { blob, sha: sha256(b), fixture };
  };
  const t = pinFile(x.module);
  const sib = need.map((p) => { const q = pinFile(p); return { repo: x.repo, commit: x.commit, path: p, fileBlob: q.blob, sha256: q.sha, fixture: q.fixture }; });
  const sf = ts.createSourceFile("m.ts", content, ts.ScriptTarget.Latest, true);
  const f = sf.statements.find((s): s is ts.FunctionDeclaration => ts.isFunctionDeclaration(s) && s.name?.text === x.fn && !!s.body)!;
  const signature = `(${f.parameters.map((p) => p.type!.getText(sf)).join(", ")}): ${f.type!.getText(sf)}`;
  if (!/\bDate\b/.test(signature) && !sib.length) throw new Error(`no Date in signature ${signature}`);
  out.push({ repo: x.repo, commit: x.commit, test: x.test, module: x.module, fn: x.fn, line: sf.getLineAndCharacterOfPosition(f.getStart(sf)).line + 1, signature, v1Refusal: r1, v2Refusal: r2, framework: x.framework, sha256: t.sha, fileBlob: t.blob, fixture: t.fixture, siblings: sib, license: classified, licenseSha256: sha256(licText.trim()) });
  pins.push({ name: x.repo, commit: x.commit, spdx: classified, classified, licenseFile: names[0] });
  notices.push({ repo: x.repo, commit: x.commit, licFile: names[0]!, licText, spdx: classified, fixtures: [t.fixture, ...sib.map((s) => s.fixture)] });
  perRepo.set(x.repo, (perRepo.get(x.repo) ?? 0) + 1);
  console.error("OK", x.repo, x.fn, r1, r2, signature.slice(0, 100), need);
} catch (e) { console.error("DROP", x.repo, x.fn, String(e).slice(0, 140)); } }
writeFileSync("te3-built.json", JSON.stringify({ out, pins, notices }, null, 1));
