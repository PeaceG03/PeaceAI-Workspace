{
  "name": "peaceai-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "tsx --test src/*.test.ts",
    "test:tools": "tsx --test peaceai/test/*.test.ts",
    "test:self": "tsx --test $(find peaceai/self-tests -name '*.test.ts' -type f | LC_ALL=C sort)",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.25.12",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
