+import assert from "node:assert/strict";
+import test from "node:test";
+import { monthNumberOf } from "./us-calendar";
+
+test("monthNumberOf returns the expected values", () => {
+  assert.equal(monthNumberOf("2026-10-17"), 10);
+  assert.equal(monthNumberOf("2026-13-01"), 0);
+  assert.equal(monthNumberOf("2026-01-05"), 1);
+});
