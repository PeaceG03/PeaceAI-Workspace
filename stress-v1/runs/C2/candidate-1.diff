   const ms = to.getTime() - from.getTime();
   return Math.round(ms / 86400000);
 }
+
+export function monthNumberOf(date: string): number {
+  const m = Number(date.slice(5, 7));
+  if (m < 1 || m > 12) return 0;
+  return m;
+}
