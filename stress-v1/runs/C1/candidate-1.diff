+import assert from "node:assert/strict";
+import test from "node:test";
+import { yearsOfStorageGb } from "./storage";
+
+test("yearsOfStorageGb returns the expected values", () => {
+  assert.equal(yearsOfStorageGb(1024, 2), 504);
+  assert.equal(yearsOfStorageGb(0, 5), 0);
+  assert.equal(yearsOfStorageGb(512, 1), 126);
