+import assert from "node:assert/strict";
+import test from "node:test";
+import { isRdustFileName } from "./rdust-names";
+
+test("isRdustFileName returns the expected values", () => {
+  assert.equal(isRdustFileName("page-001.rdust"), true);
+  assert.equal(isRdustFileName(".rdust"), false);
+  assert.equal(isRdustFileName("a.json"), false);
+});
