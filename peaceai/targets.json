{
  "schema": "peaceai-targets:v1",
  "default": "PeaceG03/PeaceAI-Workspace",
  "targets": {
    "PeaceG03/PeaceAI-Workspace": {
      "sourcePattern": "^src/[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*\\.ts$",
      "testPattern": "\\.test\\.ts$",
      "denyPatterns": [],
      "install": "npm",
      "originalSuite": "full",
      "writeEnvironment": null,
      "verdictRoute": "pr",
      "selfZone": true
    },
    "PeaceG03/PeaceSTOCKS": {
      "sourcePattern": "^src/[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*\\.ts$",
      "testPattern": "\\.test\\.ts$",
      "denyPatterns": [
        "(^|/)\\.",
        "(^|/)fixtures/",
        "test-helper",
        "secret",
        "credential",
        "token",
        "wrangler",
        "production",
        "(^|/)(host|scheduler|backfill)\\.ts$"
      ],
      "install": "pnpm",
      "originalSuite": "related",
      "writeEnvironment": "peacestocks-write",
      "verdictRoute": "pr",
      "workflowPattern": "^\\.github/workflows/tenmin-mode-sim\\.yml$",
      "tsconfigScript": true
    },
    "sindresorhus/is": {
      "sourcePattern": "^source/[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*\\.ts$",
      "testPattern": "^test/.+\\.ts$",
      "denyPatterns": [
        "(^|/)\\.",
        "(^|/)fixtures/",
        "(^|/)fixture/",
        "secret",
        "credential",
        "token"
      ],
      "install": "npm",
      "originalSuite": "related",
      "writeEnvironment": null,
      "verdictRoute": "patch"
    },
    "unjs/ufo": {
      "sourcePattern": "^src/[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*\\.ts$",
      "testPattern": "^test/.+\\.test\\.ts$",
      "denyPatterns": [
        "(^|/)\\.",
        "(^|/)fixtures/",
        "(^|/)fixture/",
        "secret",
        "credential",
        "token"
      ],
      "install": "pnpm",
      "originalSuite": "related",
      "writeEnvironment": null,
      "verdictRoute": "patch"
    },
    "blakeembrey/change-case": {
      "sourcePattern": "^packages/[A-Za-z0-9._-]+/src/[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*\\.ts$",
      "testPattern": "\\.spec\\.ts$",
      "denyPatterns": [
        "(^|/)\\.",
        "(^|/)fixtures/",
        "(^|/)fixture/",
        "secret",
        "credential",
        "token"
      ],
      "install": "npm",
      "originalSuite": "related",
      "writeEnvironment": null,
      "verdictRoute": "patch"
    },
    "gvergnaud/ts-pattern": {
      "sourcePattern": "^src/[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*\\.ts$",
      "testPattern": "^tests/.+\\.test\\.ts$",
      "denyPatterns": [
        "(^|/)\\.",
        "(^|/)fixtures/",
        "(^|/)fixture/",
        "secret",
        "credential",
        "token"
      ],
      "install": "npm",
      "originalSuite": "related",
      "writeEnvironment": null,
      "verdictRoute": "patch"
    }
  }
}
